# ParcelPilot AI Environment Configuration Example
# Copy this file to .env and configure your preferred LLM provider

# LLM Provider Toggle: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq API Configuration (Get from: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=8000
HOST=127.0.0.1
